# Salin file ini menjadi .env.local lalu isi nilai aslinya (jangan di-commit).

# Publisher ID Google AdSense (format ca-pub-diikuti angka).
# Tanpa nilai valid, seluruh slot iklan otomatis no-op.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000

# Ad unit ID dari dashboard AdSense — satu per penempatan (lihat README bagian Monetisasi).
VITE_ADSENSE_SLOT_HOME=1234567890
VITE_ADSENSE_SLOT_LEVELS=2345678901
VITE_ADSENSE_SLOT_ACHIEVEMENTS=3456789012
VITE_ADSENSE_SLOT_RESULT=4567890123
